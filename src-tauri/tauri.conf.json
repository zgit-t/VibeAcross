{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeAcross",
  "version": "1.3.0",
  "identifier": "com.vibeacross.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeAcross",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "VibeAcross",
    "copyright": "Copyright © 2026 VibeAcross",
    "category": "DeveloperTool",
    "shortDescription": "本地桌面工作区管理工具",
    "longDescription": "统一管理本地开发项目、AI 编程工具与开发任务，所有数据均保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zgit-t/VibeAcross/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RTY4OTEyQTk1QzkxRTgKUldUb2tWeXBFb25tWnlkTmNhZldjZ092M0tzaEZPU01BWXdoNWJKMlE3RGhHb0MzWmdHNERhQmgK"
    }
  }
}
